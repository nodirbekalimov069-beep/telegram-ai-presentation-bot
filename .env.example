# Application
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-at-least-32-random-characters
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Database / queue
DATABASE_URL=postgresql+asyncpg://presentation:presentation@postgres:5432/presentation
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
ADMIN_API_TOKEN=
BOT_PRIVATE_MODE=true
OWNER_TELEGRAM_ID=

# AI: openai | mock | openai_compatible
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_SECONDS=0.5

# Payments: mock | click | payme
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=replace-development-secret
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_LOGIN=Paycom
PAYME_SECRET_KEY=

# Storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=presentations
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Generation
LIBREOFFICE_BINARY=soffice
NODE_BINARY=node
PRESENTATION_RENDERER=apps/presentation_engine/render.mjs
GENERATION_WORK_ROOT=./tmp/generation
GENERATION_MAX_RETRIES=3
MAX_TOPIC_LENGTH=500
MAX_UPLOAD_BYTES=20000000
